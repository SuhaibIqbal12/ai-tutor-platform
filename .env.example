PORT=3001
DATABASE_URL=postgresql://tutor_user:CHANGE_ME@localhost:5432/ai_tutor_db?schema=public
# Generate a unique secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
REDIS_URL=redis://localhost:6379
# Optional single-process development worker. Production should run npm run worker separately.
RAG_WORKER_ENABLED=false
FRONTEND_ORIGIN=http://localhost:3000
TRUST_PROXY=false
# Configure at least one real text provider. Blank means disabled.
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=
# Optional verified Supabase OAuth and authenticated deletion webhook.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_WEBHOOK_SECRET=
# Optional writable persistent path for the local embedding model cache.
EMBEDDING_CACHE_DIR=
# Requires yt-dlp installed on the worker; enables caption fallback only.
YOUTUBE_FALLBACK_ENABLED=false
# Opt-in audio transcription: also needs GEMINI_API_KEY, yt-dlp and ffmpeg (max 10 minutes/10MB).
YOUTUBE_AUDIO_FALLBACK_ENABLED=false
PYTHON_BIN=python3
